{
    "name": "@aaix/laravel-islands",
    "version": "1.0.98",
    "description": "Elegant frontend islands for Laravel: framework-agnostic core with a Vue adapter (React planned).",
    "type": "module",
    "license": "MIT",
    "main": "resources/js/core/index.js",
    "exports": {
        ".": "./resources/js/core/index.js",
        "./ripple": "./resources/js/core/ripple.js",
        "./vue": "./resources/js/vue/index.js",
        "./vue/helpers": "./resources/js/vue/helpers/index.js",
        "./vue/helpers/wysiwyg": "./resources/js/vue/helpers/wysiwyg.js",
        "./vue/themes": "./resources/js/vue/themes/index.js",
        "./css/theme.css": "./resources/css/theme.css",
        "./css/themes/material.css": "./resources/css/themes/material.css",
        "./css/themes/soft.css": "./resources/css/themes/soft.css",
        "./css/themes/soft-filament.css": "./resources/css/themes/soft-filament.css",
        "./vite": "./vite.js"
